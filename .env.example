# Получить бесплатный токен: https://huggingface.co/settings/tokens

HF_TOKEN=hf_token

# Qdrant — URL векторной базы
# Локально (Docker на том же хосте): http://localhost:6333
# Удалённый сервер:                   http://192.168.1.50:6333
# Qdrant Cloud:                       https://xyz.cloud.qdrant.io:6333
# Docker-compose (внутренняя сеть):   http://qdrant:6333
QDRANT_URL=qdrant_url

EMBED_BATCH_SIZE=embed_batch_size